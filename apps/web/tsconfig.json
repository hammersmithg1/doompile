{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@doompile/core": [
        "../../packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/core/src/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-editor-tests/types/**/*.ts",
    ".next-editor-tests/dev/types/**/*.ts",
    ".next-mobile-tests/types/**/*.ts",
    ".next-mobile-tests/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-auth-build/types/**/*.ts",
    ".next-auth-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
