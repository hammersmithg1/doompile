{
  "name": "doompile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev apps/web --hostname 0.0.0.0",
    "build": "next build apps/web --webpack",
    "start": "next start apps/web --hostname 0.0.0.0",
    "typecheck": "next typegen apps/web && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/editor/tsconfig.json",
    "test": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test packages/core/src/*.test.ts packages/editor/test/*.test.ts apps/web/lib/server/*.test.ts apps/web/lib/client/*.test.ts && node --test extensions/clipper/test/*.test.mjs",
    "clipper:build": "node extensions/clipper/build.mjs",
    "editor:build": "node packages/editor/build.mjs",
    "ios:generate": "python3 apps/ios/generate_project.py",
    "macos:generate": "python3 apps/macos/generate_project.py",
    "macos:build": "bash apps/macos/scripts/build.sh",
    "test:editor": "playwright test -c packages/editor/playwright.config.ts",
    "shared:generate": "node scripts/generate-shared.mjs && node scripts/generate-design.mjs && node scripts/generate-telemetry.mjs",
    "shared:check": "node scripts/generate-shared.mjs --check && node scripts/generate-telemetry.mjs --check && npm run design:check",
    "verify": "node scripts/verify.mjs",
    "verify:ui": "node scripts/verify.mjs ui",
    "verify:native": "node scripts/verify.mjs native",
    "test:mobile": "playwright test -c apps/web/playwright.mobile.config.ts",
    "test:clipper": "playwright test -c extensions/clipper/playwright.config.mjs",
    "design:generate": "node scripts/generate-design.mjs",
    "design:check": "node scripts/generate-design.mjs --check && node scripts/check-design.mjs",
    "observability": "node --import tsx scripts/observability.mjs",
    "observability:check": "node scripts/generate-telemetry.mjs --check && node scripts/check-observability.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@mozilla/readability": "^0.6.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "busboy": "^1.6.0",
    "htmlparser2": "^12.0.0",
    "idb": "^8.0.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.14",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "opentype.js": "1.3.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
