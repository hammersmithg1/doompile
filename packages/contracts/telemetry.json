        "filter"
      ]
    },
    "note.opened": {
      "category": "product",
      "level": "info",
      "properties": [
        "note_id",
        "kind"
      ]
    },
    "note.saved": {
      "category": "product",
      "level": "info",
      "properties": [
        "note_id",
        "operation",
        "kind",
        "duration_ms"
      ]
    },
    "note.committed": {
      "category": "product",
      "level": "info",
      "properties": [
        "note_id",
        "operation",
        "kind"
      ]
    },
