      ]
    },
    "http.completed": {
      "category": "technical",
      "level": "info",
      "properties": [
        "route",
        "method",
        "status",
        "duration_ms"
      ]
    },
    "http.failed": {
      "category": "technical",
      "level": "error",
      "properties": [
        "route",
        "method",
        "status",
        "duration_ms",
        "error_code",
        "error_type",
        "stack"
      ]
    },
    "runtime.error": {
      "category": "technical",
      "level": "error",
      "properties": [
        "error_code",
        "error_type",
        "stack"
      ]
    },
    "auth.succeeded": {
      "category": "product",
      "level": "info",
      "properties": [
        "provider"
      ]
    },
    "auth.signed_out": {
      "category": "product",
      "level": "info",
      "properties": []
    },
    "diagnostics.exported": {
      "category": "technical",
      "level": "info",
      "properties": [
        "count"
      ]
    },
    "runtime.crash": {
      "category": "technical",
      "level": "error",
      "properties": [
        "count",
        "duration_ms",
        "stack",
        "diagnostic_build"
      ]
    },
    "runtime.hang": {
      "category": "technical",
      "level": "error",
      "properties": [
        "count",
        "duration_ms",
        "stack",
        "diagnostic_build"
      ]
    },
    "telemetry.rejected": {
      "category": "technical",
      "level": "warn",
      "properties": [
        "count",
        "status",
        "error_code",
        "client_schema"
      ]
    }
