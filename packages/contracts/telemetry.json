      "category": "product",
      "level": "info",
      "properties": []
    },
    "recording.completed": {
      "category": "product",
      "level": "info",
      "properties": [
        "duration_ms",
        "bytes"
      ]
    },
    "recording.failed": {
      "category": "technical",
      "level": "error",
      "properties": [
        "error_code",
        "error_type",
        "stack"
      ]
    },
    "editor.ready": {
      "category": "technical",
      "level": "info",
      "properties": [
        "duration_ms"
      ]
    },
    "editor.action": {
      "category": "product",
      "level": "info",
      "properties": [
        "action"
      ]
    },
    "editor.failed": {
      "category": "technical",
      "level": "error",
      "properties": [
        "error_code",
        "error_type",
        "stack"
      ]
    },
    "storage.failed": {
      "category": "technical",
      "level": "error",
      "properties": [
        "operation",
        "error_code",
        "error_type",
        "stack"
      ]
    },
    "sync.started": {
      "category": "technical",
      "level": "info",
      "properties": [
        "pending",
        "pull"
      ]
    },
    "sync.completed": {
      "category": "technical",
      "level": "info",
      "properties": [
        "pending",
        "failed",
        "duration_ms",
        "pull"
      ]
    },
    "sync.failed": {
      "category": "technical",
      "level": "error",
      "properties": [
        "pending",
        "duration_ms",
        "error_code",
        "error_type",
        "stack",
        "failed",
        "pull"
      ]
